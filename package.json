{
  "name": "custom-field-maker",
  "version": "1.7.4",
  "description": "custom field maker for a-blog cms",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appleple/custom-field-maker.git"
  },
  "files": [
    "dist",
    "lib",
    "css",
    "json",
    "screenshot.png"
  ],
  "overrides": {
    "tmp": "^0.2.5",
    "brace-expansion": "^5.0.8",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "scripts": {
    "build": "npm run build:babel && npm run build:json && npm run build:svgo && npm run build:prod",
    "build:babel": "babel src --out-dir lib --extensions .js,.jsx,.ts,.tsx",
    "build:json": "cp -r ./src/json ./lib/",
    "build:svgo": "svgo ./src/assets/images -o ./lib/assets/images",
    "build:prod": "NODE_ENV=production webpack --config webpack.prod.mjs",
    "dev": "webpack serve --config webpack.dev.mjs",
    "start": "npm run dev",
    "prettier": "prettier ./src/**/*.js --write",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "preversion": "npm run build && npm run test:run",
    "postversion": "git push && git push --tags",
    "release:major": "npm version major",
    "release:minor": "npm version minor",
    "release:patch": "npm version patch",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "author": "appleple",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "classnames": "^2.5.1",
    "highlight.js": "~11.12.0",
    "html-entities": "^2.6.0",
    "js-beautify": "2.0.3",
    "react-copy-to-clipboard": "^5.1.0",
    "react-tooltip": "^5.28.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0 <20.0.0",
    "react-dom": ">=16.8.0 <20.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "globals": "^17.8.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "style-loader": "^4.0.0",
    "svgo": "^4.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "webpack": "^5.109.1",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.4"
  }
}
